# Copy to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.

# Analytics (optional). When unset, the Analytics component renders nothing.
NEXT_PUBLIC_GA_ID=

# Feature flags (default true unless noted). Set to "false" or "0" to disable.
NEXT_PUBLIC_SHOW_CLIENT_LOGOS=true
NEXT_PUBLIC_SHOW_TESTIMONIALS=true
NEXT_PUBLIC_SHOW_TRANSACTIONS=true
NEXT_PUBLIC_SHOW_AWARDS=true
NEXT_PUBLIC_AGGRESSIVE_CTA_COPY=true
NEXT_PUBLIC_SHOW_CREDENTIAL_BADGES=true
NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_CAPTCHA=false

# Lead provider selector (reserved — only ConsoleLeadProvider is wired today).
# LEAD_PROVIDER=hubspot
